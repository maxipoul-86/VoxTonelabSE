{
  "name": "vox-tonelab-se-tone-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turns a song or band into VOX Tonelab SE settings and sends them over MIDI.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "tones": "node tones/build.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "volta": {
    "node": "22.22.2"
  }
}
